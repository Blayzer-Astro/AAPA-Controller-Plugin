<ResourceDictionary
    x:Class="NINA.Plugins.AAPA.Dockables.AAPADockableTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugins.AAPA.Dockables"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- ═══════════════════════════════════════════════════════════
         AAPA Controller Dockable Panel
         Displays connection status, TPPA errors, manual nudge
         controls, auto-pilot controls, and motor configuration.
    ════════════════════════════════════════════════════════════════ -->
    <DataTemplate DataType="{x:Type local:AAPADockable}">
        <DataTemplate.Resources>
            <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#EF4444"/>
                <Setter Property="Foreground" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#B91C1C"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#16A34A"/>
                <Setter Property="Foreground" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#15803D"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </DataTemplate.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6" Background="{StaticResource BackgroundBrush}">

                <!-- ── Header ─────────────────────────────────── -->
                <TextBlock Text="AAPA Controller"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,8"/>

                <!-- ── Connection ─────────────────────────────── -->
                <GroupBox Header="Connection" Margin="0,0,0,6">
                    <StackPanel Orientation="Vertical" Margin="4">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="COM Port:" Width="80" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPort}"
                                      Width="110" Margin="4,0"/>
                            <Button Content="↻" Width="30"
                                    Command="{Binding RefreshPortsCommand}"
                                    Margin="2,0" ToolTip="Refresh port list"/>
                            <Button Content="{Binding ConnectButtonLabel}"
                                    Command="{Binding ConnectToggleCommand}"
                                    Width="90" Margin="6,0"/>
                        </StackPanel>

                        <!-- Status row -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Disconnected"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="{Binding ConnectedPort, StringFormat='Connected: {0}'}"/>
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text=" | X:" Margin="10,0,2,0" Foreground="White"/>
                            <TextBlock Text="{Binding PositionX}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text=" Y:" Margin="4,0,2,0" Foreground="White"/>
                            <TextBlock Text="{Binding PositionY}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="[MOVING]"/>
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHomed}" Value="True">
                                                <Setter Property="Text" Value="[HOMED]"/>
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Homing buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Button Content="Go to X=0"
                                    Command="{Binding HomeAzimuthCommand}"
                                    Width="80" Margin="0,0,6,0"
                                    ToolTip="Moves the azimuth axis back to the 0 position"/>
                            <Button Content="Go to Y=0"
                                    Command="{Binding HomeAltitudeCommand}"
                                    Width="80" Margin="0,0,6,0"
                                    ToolTip="Moves the altitude axis back to the 0 position"/>
                            <Button Content="Reset X=0"
                                    Command="{Binding ResetXCommand}"
                                    Width="80" Margin="0,0,6,0"
                                    ToolTip="Set current X position to 0"/>
                            <Button Content="Reset Y=0"
                                    Command="{Binding ResetYCommand}"
                                    Width="80" Margin="0,0,6,0"
                                    ToolTip="Set current Y position to 0"/>
                            <Button Content="⏹ STOP"
                                    Command="{Binding StopCommand}"
                                    Width="70" Style="{StaticResource RedButton}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ── TPPA Error Display ──────────────────────── -->
                <GroupBox Header="TPPA Polar Alignment Error" Margin="0,0,0,6">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- Labels -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Azimuth"
                                   HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Altitude"
                                   HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Total"
                                   HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>

                        <!-- Values -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding AzimuthErrorDeg, StringFormat='{}{0:+0.0000;-0.0000}°'}"
                                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding AltitudeErrorDeg, StringFormat='{}{0:+0.0000;-0.0000}°'}"
                                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{Binding TotalErrorArcSec, StringFormat='{}{0:0.0}″'}"
                                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Grid>
                </GroupBox>

                <!-- ── Manual Nudge ───────────────────────────── -->
                <GroupBox Header="Manual Nudge" Margin="0,0,0,6">
                    <StackPanel Margin="4">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Step (°):" VerticalAlignment="Center" Width="70"/>
                            <TextBox Text="{Binding NudgeDegrees}"
                                     Width="70" Margin="4,0"/>
                        </StackPanel>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Azimuth"
                                       HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Altitude"
                                       HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="◀" Width="50" Margin="2"
                                        Command="{Binding NudgeAzimuthNegCommand}"
                                        IsEnabled="{Binding IsConnected}"/>
                                <Button Content="▶" Width="50" Margin="2"
                                        Command="{Binding NudgeAzimuthPosCommand}"
                                        IsEnabled="{Binding IsConnected}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="▼" Width="50" Margin="2"
                                        Command="{Binding NudgeAltitudeNegCommand}"
                                        IsEnabled="{Binding IsConnected}"/>
                                <Button Content="▲" Width="50" Margin="2"
                                        Command="{Binding NudgeAltitudePosCommand}"
                                        IsEnabled="{Binding IsConnected}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ── Auto-Pilot ─────────────────────────────── -->
                <GroupBox Header="Auto-Pilot" Margin="0,0,0,6">
                    <StackPanel Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tolerance (°):" Margin="0,4,8,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ToleranceDegrees}" Margin="0,4,8,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Settle (s):" Margin="0,4,8,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SettleTimeSeconds}" Margin="0,4,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Iter.:" Margin="0,4,8,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxIterations}" Margin="0,4,8,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Max Corr. (°):" Margin="0,4,8,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MaxCorrectionDeg}" Margin="0,4,0,4"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="▶ Start Auto-Pilot"
                                    Command="{Binding StartAutoPilotCommand}"
                                    Width="140" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsConnected}"
                                    Style="{StaticResource GreenButton}"/>
                            <Button Content="■ Stop"
                                    Command="{Binding StopAutoPilotCommand}"
                                    Width="60"
                                    IsEnabled="{Binding AutoPilotRunning}"
                                    Style="{StaticResource RedButton}"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding AutoPilotRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Iteration {0}">
                                        <Binding Path="AutoPilotIteration"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ── Ratio Calibration ────────────────────────────── -->
                <GroupBox Header="Ratio Calibration" Margin="0,0,0,6">
                    <StackPanel Margin="4">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Test Steps:" VerticalAlignment="Center" Width="70"/>
                            <TextBox Text="{Binding CalibrationSteps}" Width="70" Margin="4,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Button Content="Calibrate Azimuth (X)"
                                    Command="{Binding CalibrateAzimuthCommand}"
                                    Width="150" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsConnected}"/>
                            <Button Content="Calibrate Altitude (Y)"
                                    Command="{Binding CalibrateAltitudeCommand}"
                                    Width="150"
                                    IsEnabled="{Binding IsConnected}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ── Motor Settings ─────────────────────────── -->
                <GroupBox Header="Motor / Gearing" Margin="0,0,0,6">
                    <Expander Header="Expand Motor Settings" IsExpanded="False">
                        <StackPanel>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Steps/Rev -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Steps/Rev:" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StepsPerRevolution}" Margin="0,3,8,3"/>

                            <!-- Microsteps -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Az Microsteps:" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AzimuthMicrosteps}" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Alt Microsteps:" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AltitudeMicrosteps}" Margin="0,3,0,3"/>

                            <!-- Gear Ratio -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Az Gear Ratio:" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AzimuthGearRatio}" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Alt Gear Ratio:" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding AltitudeGearRatio}" Margin="0,3,0,3"/>

                            <!-- Reversal -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Reverse Az:" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding ReverseAzimuth}" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Reverse Alt:" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding ReverseAltitude}" Margin="0,3,0,3" VerticalAlignment="Center"/>

                            <!-- Backlash -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Az Backlash (steps):" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AzimuthBacklash}" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Alt Backlash (steps):" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding AltitudeBacklash}" Margin="0,3,0,3"/>

                            <!-- Speed / Accel -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Az Speed (sps):" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding AzimuthSpeed}" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Alt Speed (sps):" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding AltitudeSpeed}" Margin="0,3,0,3"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Az Accel (sps²):" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AzimuthAccel}" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="Alt Accel (sps²):" Margin="0,3,8,3" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding AltitudeAccel}" Margin="0,3,0,3"/>

                            <!-- Altitude Limits -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Min Alt Limit:" Margin="0,3,8,3" VerticalAlignment="Center" ToolTip="Minimum altitude steps (relative to home)."/>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding MinYLimit}" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="7" Grid.Column="2" Text="Max Alt Limit:" Margin="0,3,8,3" VerticalAlignment="Center" ToolTip="Maximum altitude steps (relative to home)."/>
                            <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding MaxYLimit}" Margin="0,3,0,3"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <Button Content="Send to AAPA &amp; Save"
                                    Command="{Binding SendSpeedAccelCommand}"
                                    Width="160" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsConnected}"/>
                            <Button Content="Save Settings"
                                    Command="{Binding SaveSettingsCommand}"
                                    Width="110"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </GroupBox>

                <!-- ── Activity Log ───────────────────────────── -->
                <GroupBox Header="Log" Margin="0,0,0,6">
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="160"
                             FontFamily="Consolas"
                             FontSize="10"
                             Background="#0A0A0F"
                             Foreground="#22D3AA"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
